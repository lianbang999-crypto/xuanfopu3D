{
  // 选佛谱 · 十法界须弥山世界 —— Cloudflare 部署配置
  // 部署：npm run deploy（= vite build + wrangler deploy）
  "name": "xuanfopu-sumeru",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "game.foyue.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" }
    ]
  },
  // 问谱 v3（2026-08-12 覆盖部署于同名 worker xuanfopu-agent-v2）：检索谱内全文 692 块 → 据文生成，
  // 句级核验、逐句角标；协议 ndjson meta/delta/done 不变，故此绑定与前端无须随之改动。
  // 旧管线（定本路由/意图层/问文库旁路）git 可考；更旧的 xuanfopu-evidence-agent 未删，仍可回退。
  "services": [
    { "binding": "ASK_SERVICE", "service": "xuanfopu-agent-v2" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] }
  ],
  "observability": { "enabled": true }
}
