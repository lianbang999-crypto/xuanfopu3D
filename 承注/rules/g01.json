        "inherit": []
      },
      "status": "定"
    },
    {
      "id": "R1-10",
      "title": "上品十善",
      "source": {
        "pos": "g01-10",
        "name": "上品十善",
        "line": 81
      },
      "authority": "本位專說",
      "items": [
        {
          "combos": [
            "那那"
          ],
          "quote": "那那則見網牢固故成十仙"
        },
        {
          "combos": [
            "那謨"
          ],
          "quote": "那謨則煩惑紛陳故為魔侶。"
        },
        {
          "combos": [
            "謨謨"
          ],
          "quote": "謨謨雖有愛染不起見執故生北洲。北洲雖不及天死必生天無退墮故。"
        },
        {
          "combos": [
            "阿阿",
            "阿彌",
            "彌彌",
            "阿陀",
            "彌陀",
            "陀陀"
          ],
          "quote": "阿阿等六如次生六欲天可知。"
        },
        {
          "combos": [
            "那佛"
          ],
          "quote": "大善之人既知佛理必有所證。但那佛未伏法執僅階煖位"
        },
        {
          "combos": [
            "謨佛"
          ],
          "quote": "謨佛未離法愛僅登性地。"
        },
        {
          "combos": [
            "阿佛"
          ],
          "quote": "阿佛初捨劣心堪成別信。"
        },
        {
          "combos": [
            "彌佛"
          ],
          "quote": "彌佛持佛妙戒能遵五品。"
        },
        {
          "combos": [
            "陀佛"
          ],
          "quote": "陀佛定慧均平可超內院。"
        },
        {
          "combos": [
            "佛佛"
          ],
          "quote": "佛佛則具諸戒行圓發三心。(至誠心。深心迴向發願心)徑得上品上生矣。"
        }
      ],
      "scope": {
        "self": "g01-10",
        "inherit": []
      },
      "status": "定"
    },
    {
      "id": "R1-11",
      "title": "邪定",
      "source": {
        "pos": "g01-11",
        "name": "邪定",
        "line": 85
      },
      "authority": "本位專說",
      "items": [
        {
          "combos": [
            "那那",
            "那謨",
            "謨謨"
          ],
          "quote": "那那等三惑業既重縱有定力還墮鬼畜類中。"
        },
        {
          "combos": [
            "阿阿",
            "阿彌",
            "彌彌"
          ],
          "quote": "修邪定人不肯勤修施戒散善故阿阿等三種不行。",
          "verdict": "不行"
        },
        {
          "combos": [
            "那陀",
            "謨陀"
          ],
          "quote": "那陀謨陀乃於定中妄起見愛計為出要故必生無想天。",
          "note": "本門唯邪定・味禪・根本四禪・意見參禪四位之那陀謨陀得行，餘位仍依卷一相雜通則不行。"
        },
        {
          "combos": [
            "阿陀"
          ],
          "quote": "阿陀則捨色入空。"
        },
        {
          "combos": [
            "彌陀"
          ],
          "quote": "彌陀則棄空緣識。"
        },
        {
          "combos": [
            "陀陀"
          ],
          "quote": "陀陀則離識緣無所有。"
        },
        {
          "combos": [
            "那佛"
          ],
          "quote": "那佛見惑未除雖甚利根還生有頂。(即非非想處天)"
        },
        {
          "combos": [
            "謨佛"
          ],
          "quote": "謨佛愛習尚重雖聞佛法須習停心。"
        },
        {
          "combos": [
            "阿佛",
            "彌佛",
            "陀佛"
          ],
          "quote": "阿佛等三即世間定堪通出世間定。"
        },
        {
          "combos": [
            "佛佛"
          ],
          "quote": "佛佛純慧照了邪相便可通達正相矣。"
        }
      ],
      "scope": {
        "self": "g01-11",
        "inherit": []
      },
      "status": "定"
    },
    {
      "id": "R1-12",
