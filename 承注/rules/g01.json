        },
        {
          "combos": [
            "阿阿",
            "阿彌",
            "彌彌",
            "阿陀"
          ],
          "quote": "阿阿等四。隨應生於四洲。"
        },
        {
          "combos": [
            "彌陀"
          ],
          "quote": "彌陀又勝。故王南洲。"
        },
        {
          "combos": [
            "陀陀"
          ],
          "quote": "陀陀最勝。故統四洲。"
        },
        {
          "combos": [
            "那佛"
          ],
          "quote": "純善之人。知有佛法。必入法門。但那佛則分別習強。故志取偏真。"
        },
        {
          "combos": [
            "謨佛"
          ],
          "quote": "謨佛則恩愛為苦。故樂獨善寂。"
        },
        {
          "combos": [
            "阿佛",
            "彌佛",
            "陀佛",
            "佛佛"
          ],
          "quote": "阿佛以下。自應如次發於四種大菩提心。"
        }
      ],
      "scope": {
