      "status": "定",
      "authorityNote": "本位末云「此中對待絕待二論。例前見取可知」——義理層承 g01-04 見取位，非行法承注。"
    },
    {
      "id": "R1-08",
      "title": "下品十善",
      "source": {
        "pos": "g01-08",
        "name": "下品十善",
        "line": 73
      },
      "authority": "本位專說",
      "items": [
        {
          "combos": [
            "那那",
            "那謨",
            "謨謨"
          ],
          "quote": "那那等三。煩惱重故。皆為畜脩。"
        },
        {
          "combos": [
            "阿阿",
            "阿彌"
          ],
          "quote": "阿阿等二稍勝。故為鬼脩。"
        },
        {
          "combos": [
            "彌彌",
            "阿陀"
          ],
          "quote": "彌彌阿陀又勝。故為人脩。"
        },
        {
          "combos": [
            "彌陀",
            "陀陀"
          ],
          "quote": "彌陀等二更勝。故為天脩。"
        },
        {
          "combos": [
            "那佛"
          ],
          "quote": "凡行善人。知有佛字。必發出世間心。但那佛。則見習尚強。故為意見參禪。"
        },
        {
          "combos": [
            "謨佛"
          ],
          "quote": "謨佛則愛習仍重。故為利名習教。"
        },
        {
          "combos": [
            "阿佛",
            "彌佛",
            "陀佛",
            "佛佛"
          ],
          "quote": "阿佛以下。自應如次修行施戒禪慧也。"
        }
      ],
      "scope": {
        "self": "g01-08",
        "inherit": []
      },
      "status": "定"
    },
    {
