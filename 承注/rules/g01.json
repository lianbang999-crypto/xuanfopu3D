        },
        {
          "combos": [
            "阿陀"
          ],
          "quote": "阿陀初捨欲界故生梵眾。"
        },
        {
          "combos": [
            "彌陀"
          ],
          "quote": "彌陀定善稍深故生少光。"
        },
        {
          "combos": [
            "陀陀"
          ],
          "quote": "陀陀禪力倍增故生少淨。"
        },
        {
          "combos": [
            "那佛"
          ],
          "quote": "那佛則身見雖重堪作請轉法輪之主故為大梵。"
        },
        {
          "combos": [
