          ],
          "quote": "那佛則欲摧諸見。故願親補處慈尊。"
        },
        {
          "combos": [
            "謨佛"
          ],
          "quote": "謨佛則欲渡愛河。故求生極樂世界。"
        },
        {
          "combos": [
            "阿佛"
          ],
          "quote": "阿佛則先除麤垢。證圓十心。"
        },
        {
          "combos": [
            "彌佛"
          ],
          "quote": "彌佛則具戒發心。登上上品。"
        },
        {
          "combos": [
            "陀佛"
          ],
          "quote": "陀佛則定慧圓明。遂得佛知見開。"
        },
        {
          "combos": [
