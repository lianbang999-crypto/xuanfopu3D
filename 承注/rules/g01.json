      "status": "定"
    },
    {
      "id": "R1-13",
      "title": "根本四禪",
      "source": {
        "pos": "g01-13",
        "name": "根本四禪",
        "line": 93
      },
      "authority": "本位專說",
      "items": [
        {
          "combos": [
            "那那",
            "那謨",
            "謨謨"
          ],
          "quote": "善修根本四禪。能伏見愛。故那那等不行。",
          "verdict": "不行"
        },
        {
          "combos": [
            "阿阿"
          ],
          "quote": "阿阿資以施福。故生梵輔。"
        },
        {
          "combos": [
            "阿彌"
          ],
          "quote": "阿彌施戒資禪。故生無量光天。"
        },
        {
          "combos": [
            "彌彌"
          ],
          "quote": "彌彌倍資禪力。故生無量淨天。"
        },
        {
          "combos": [
            "那陀",
            "謨陀"
          ],
          "quote": "那陀謨陀。皆具定力而墮愛見。故生無想。"
        },
        {
          "combos": [
            "阿陀"
          ],
          "quote": "阿陀與彌彌功等。亦生無量淨天。"
        },
        {
          "combos": [
            "彌陀"
          ],
          "quote": "彌陀禪善又勝故感福生。"
        },
        {
          "combos": [
            "陀陀"
          ],
          "quote": "陀陀根本中最。故生福愛。(廣果。須於第四定兼修四無量心故。)"
        },
        {
          "combos": [
            "那佛"
          ],
          "quote": "那佛知求出世。見惑未除。須修總相念觀。"
        },
        {
          "combos": [
            "謨佛"
          ],
          "quote": "謨佛雖已伏見。未全伏思。僅成煖位善根。"
        },
        {
          "combos": [
            "阿佛"
          ],
          "quote": "阿佛見生滅理。按位入無煩天。"
        },
        {
          "combos": [
            "彌佛"
          ],
          "quote": "彌佛觀法無生。無間具足八忍。"
        },
        {
          "combos": [
            "陀佛"
          ],
          "quote": "陀佛發中道解。見惑先除。故成初發心住。"
        },
        {
          "combos": [
            "佛佛"
          ],
          "quote": "佛佛觀於禪境即不思議。故階圓信十心。"
        }
      ],
      "scope": {
        "self": "g01-13",
        "inherit": []
      },
      "status": "定"
    },
    {
      "id": "R1-14",
      "title": "四無量心",
      "source": {
