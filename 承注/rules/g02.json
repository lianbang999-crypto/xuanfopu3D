        {
          "combos": [
            "陀佛"
          ],
          "quote": "陀佛。則一心念佛以除疑。"
        },
        {
          "combos": [
            "佛佛"
          ],
          "quote": "佛佛。則深觀邪見之實相也。"
        }
      ],
      "scope": {
        "self": "g02-03",
        "inherit": []
