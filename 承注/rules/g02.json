    {
      "id": "R2-04",
      "title": "棄多聞",
      "source": {
        "pos": "g02-04",
        "name": "棄多聞",
        "line": 27
      },
      "authority": "本位專說",
      "items": [
        {
          "combos": [
            "那那"
          ],
          "quote": "既棄多聞。便成癡昧。更加以見思惡業。安得不從墜落。故那那則墮有間。"
        },
        {
          "combos": [
            "那謨"
          ],
          "quote": "那謨則為下畜。"
        },
        {
          "combos": [
            "謨謨"
          ],
          "quote": "謨謨則為中畜也。"
        },
        {
          "combos": [
            "阿阿"
          ],
          "quote": "阿阿雖有施福。由癡暗故。仍為上畜。"
        },
        {
          "combos": [
            "阿彌"
          ],
          "quote": "阿彌雖有施戒。以愚劣故。仍為畜脩。"
        },
        {
          "combos": [
            "彌彌",
            "阿陀"
          ],
          "quote": "彌彌。阿陀。雖有福力。佛法緣疏。故為西洲。"
        },
        {
          "combos": [
            "彌陀"
          ],
          "quote": "彌陀福雖又勝。法緣仍遠。故為北洲。"
        },
        {
          "combos": [
            "陀陀"
          ],
          "quote": "陀陀深入四禪。故為無聞比丘竟同無想外道。"
        },
        {
          "combos": [
            "那佛",
            "謨佛"
          ],
          "quote": "那佛。謨佛。雖具煩惱。猶不忘佛。故能聽法。"
        },
        {
          "combos": [
            "阿佛"
          ],
          "quote": "阿佛。於生滅門。離文求證。故為辟支佛心。"
        },
        {
          "combos": [
            "彌佛"
          ],
          "quote": "彌佛。於無生門。忘言會理。故為修體空觀。"
        },
        {
          "combos": [
            "陀佛"
          ],
          "quote": "陀佛。則不著筌蹏漸觀中道。"
        },
        {
          "combos": [
            "佛佛"
          ],
          "quote": "佛佛。則少聞多解。頓企圓修也。"
        }
      ],
      "scope": {
        "self": "g02-04",
        "inherit": []
      },
      "status": "定"
    },
