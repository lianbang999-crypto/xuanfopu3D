      },
      "authority": "本位專說",
      "items": [
        {
          "combos": [
            "那那"
          ],
          "quote": "那那。則破戒之後。起大邪見。撥無因果。故墮阿鼻。"
        },
        {
          "combos": [
            "那謨"
          ],
          "quote": "那謨。則見思並強。更增惡業。故墮無間。"
        },
        {
          "combos": [
            "謨謨"
          ],
          "quote": "謨謨。則癡愛覆心。不知改悔。故墮中畜。"
        },
        {
          "combos": [
            "阿阿"
          ],
          "quote": "阿阿。則猶有施善。故為少財。"
        },
        {
          "combos": [
            "阿彌"
          ],
          "quote": "阿彌。則施戒略存。故為上畜。"
        },
        {
          "combos": [
            "彌彌"
          ],
          "quote": "彌彌。則猶護餘戒。故為畜脩。"
        },
        {
          "combos": [
            "阿陀"
          ],
          "quote": "阿陀。則有施有定。故為有財。"
        },
        {
          "combos": [
            "彌陀"
          ],
          "quote": "彌陀。則存戒兼定。故為鬼脩。"
        },
        {
          "combos": [
            "陀陀"
          ],
          "quote": "陀陀。則禪定現前。故成魔侶。"
        },
